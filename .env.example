# Copy ke `.env.local` lalu isi nilainya (jangan commit file .env*).
# DATABASE_URL: dari Vercel Marketplace (Neon) atau https://console.neon.tech
#   → pakai POOLED connection string (hostname mengandung "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.aws-ap-southeast-1.aws.neon.tech/dbname?sslmode=require"
# BETTER_AUTH_SECRET: string acak ≥32 char. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak"
# BETTER_AUTH_URL: base URL aplikasi (lokal / production Vercel).
BETTER_AUTH_URL="http://localhost:3000"
