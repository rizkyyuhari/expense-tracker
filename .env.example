# Copy ke `.env.local` lalu isi nilainya (jangan commit file .env*).
# DATABASE_URL: dari Vercel Marketplace (Neon) atau https://console.neon.tech
#   → pakai POOLED connection string (hostname mengandung "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.aws-ap-southeast-1.aws.neon.tech/dbname?sslmode=require"
# BETTER_AUTH_SECRET: string acak ≥32 char. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak"
# BETTER_AUTH_URL: base URL aplikasi (lokal / production Vercel).
BETTER_AUTH_URL="http://localhost:3000"
# --- Bot Telegram struk-OCR (Fase 1, opsional) ---
# TELEGRAM_BOT_TOKEN: dari @BotFather (/newbot). Rahasia, jangan share.
TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET: string acak untuk verifikasi webhook (bebas isi).
TELEGRAM_WEBHOOK_SECRET="ganti-dengan-string-acak"
# TELEGRAM_BOT_USERNAME: username bot tanpa @ (untuk tombol t.me). Opsional.
TELEGRAM_BOT_USERNAME=""
# GEMINI_API_KEY: dari Google AI Studio (gratis). Untuk baca foto struk.
GEMINI_API_KEY=""
# GEMINI_MODEL: opsional. Kosongkan = otomatis (coba gemini-2.5-flash lalu
# fallback ke model gratis lain). Isi manual hanya bila tahu ID yang aktif
# di AI Studio (ID model Gemini sering dipensiunkan Google).
GEMINI_MODEL=""
# Daftarkan webhook SETELAH deploy production:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<PROD_URL>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# --- Cron gaji rutin (opsional, untuk Vercel Cron harian) ---
# CRON_SECRET: string acak untuk mengamankan /api/cron/recurring.
CRON_SECRET="ganti-dengan-string-acak"
